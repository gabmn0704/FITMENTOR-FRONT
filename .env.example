# Copia este archivo a .env.local para desarrollo. Nunca subas .env.local.

# Base del backend. En desarrollo, por defecto http://localhost:8080.
# En producción (Netlify) define la URL pública del backend.
VITE_API_URL=http://localhost:8080

# Cliente OAuth de Google (Google Identity Services). Opcional: si está vacío,
# el botón de Google se oculta y solo queda "Entrar como invitado".
VITE_GOOGLE_CLIENT_ID=
